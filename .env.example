# Copy these into your hosting provider's environment settings (for example Vercel > Settings > Environment Variables).
# Never commit real keys. Anything left empty simply keeps that feature switched off.

# Your real site address. Used for the sitemap, canonical links and share previews.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# "Ask about my work" assistant (page: /ask). Without a key the page says it is not switched on.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5. A smaller model such as claude-haiku-5-5 costs far less per question.
ASK_MODEL=

# Contact form (Resend). Without these the form opens the visitor's email app instead.
RESEND_API_KEY=
CONTACT_TO=you@example.com
# Optional. Must be a sender verified in Resend. Defaults to Resend's test sender.
CONTACT_FROM=

# Newsletter sign-up (Resend audience). The sign-up box only appears when both RESEND_API_KEY and this are set.
RESEND_AUDIENCE_ID=

# Shared rate limiting (Upstash Redis REST). Optional but recommended before enabling the Ask assistant,
# contact form or newsletter. Without them, limits are kept per server instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
